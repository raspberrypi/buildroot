config BR2_PACKAGE_RPI_UTILS
	bool "rpi-utils"
	depends on BR2_arm || BR2_aarch64
	help
	  Raspberry Pi utilities. Only the selected tools are built.

	  https://github.com/raspberrypi/utils

if BR2_PACKAGE_RPI_UTILS

config BR2_PACKAGE_RPI_UTILS_VCGENCMD
	bool "vcgencmd"
	default y
	help
	  Sends commands to the VideoCore firmware.

config BR2_PACKAGE_RPI_UTILS_VCLOG
	bool "vclog"
	default y
	help
	  Displays the VideoCore firmware message and assert logs.

endif
